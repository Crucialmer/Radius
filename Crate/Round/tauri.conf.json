{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "Radius",
	"identifier": "app.radius.desktop",
	"build": {
		"beforeBuildCommand": "pnpm run Build",
		"beforeDevCommand": "pnpm run dev",
		"devUrl": "http://127.0.0.1:1420",
		"frontendDist": "../../Package/Web/Target"
	},
	"app": {
		"security": {
			"assetProtocol": {
				"enable": false,
				"scope": []
			},
			"capabilities": [],
			"csp": null,
			"dangerousDisableAssetCspModification": false,
			"freezePrototype": false,
			"pattern": {
				"use": "brownfield"
			}
		},
		"windows": [],
		"withGlobalTauri": false
	},
	"bundle": {
		"active": false,
		"category": "Utility",
		"copyright": "Copyright (c) 2026 Crucialmer. All rights reserved.",
		"externalBin": [],
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.ico"
		],
		"longDescription": "Radius draws Apple Squircle rounded corners over every connected Windows monitor: one transparent, click-through overlay per screen, controlled from the system tray.",
		"resources": [],
		"shortDescription": "Rounded corners on every Windows monitor.",
		"targets": [],
		"windows": {
			"allowDowngrades": false,
			"certificateThumbprint": null,
			"digestAlgorithm": "sha256",
			"timestampUrl": null,
			"tsp": true,
			"webviewInstallMode": {
				"silent": true,
				"type": "downloadBootstrapper"
			}
		}
	}
}
